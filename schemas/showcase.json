{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": { "$ref": "#/definitions/showcase" },

  "definitions": {
    "showcase": {
      "allOf": [
        { "$ref": "#/definitions/baseProperties" },
        {
          "if": {
            "properties": { "type": { "const": "grouped" } }
          },
          "then": {
            "$ref": "#/definitions/groupedShowcase"
          },
          "else": {
            "allOf": [
              { "$ref": "#/definitions/extraProperties" },
              { "$ref": "#/definitions/otherProperties" },
              {
                "if": {
                  "properties": { "type": { "const": "embed" } }
                },
                "then": {
                  "$ref": "#/definitions/embedShowcase"
                }
              },
              {
                "if": {
                  "properties": { "type": { "const": "image" } }
                },
                "then": {
                  "$ref": "#/definitions/imageShowcase"
                }
              },
              {
                "if": {
                  "properties": { "type": { "const": "model" } }
                },
                "then": {
                  "$ref": "#/definitions/modelShowcase"
                }
              },
              {
                "if": {
                  "properties": { "type": { "const": "scratch" } }
                },
                "then": {
                  "$ref": "#/definitions/scratchShowcase"
                }
              },
              {
                "if": {
                  "properties": { "type": { "const": "link" } }
                },
                "then": {
                  "$ref": "#/definitions/linkShowcase"
                }
              }
            ]
          }
        }
      ]
    },
    "baseProperties": {
      "properties": {
        "name": { "type": "string", "default": "無名の作品" },
        "type": { "$ref": "#/definitions/typeEnum" },
        "flags": { "$ref": "#/definitions/flags" },
        "tags": { "$ref": "#/definitions/tags" },
        "version": { "$ref": "#/definitions/version" },
        "status": { "enum": ["normal", "disabled", "hidden"] }
      },
      "required": ["name", "type"]
    },
    "extraProperties": {
      "type": "object",
      "properties": {
        "category": { "$ref": "#/definitions/categoryEnum" },
        "thumbnailSrc": { "type": "string", "default": "./showcase/default_thumbnail.webp" }
      },
      "required": ["category", "thumbnailSrc"]
    },
    "otherProperties": {
      "properties": {
        "id": { "type": "string" }
      },
      "required": ["id"]
    },

    "typeEnum": {
      "enum": ["embed", "image", "model", "scratch", "link", "grouped"]
    },
    "categoryEnum": {
      "anyOf": [
        {
          "enum": ["media", "model", "game"]
        },
        {
          "type": "string"
        }
      ]
    },
    "version": {
      "type": "string"
    },

    "embedShowcase": {
      "properties": {
        "src": { "type": "string" }
      },
      "required": ["src"]
    },
    "imageShowcase": {
      "properties": {
        "imageSrc": { "type": "string" }
      },
      "required": ["imageSrc"]
    },
    "modelShowcase": {
      "properties": {
        "modelSrc": { "type": "string", "default": "./showcase/default_model.glb" },
        "clearColor": {
          "type": "string",
          "pattern": "0x[0-9A-Fa-f]{6}"
        }
      },
      "required": ["modelSrc"]
    },
    "scratchShowcase": {
      "properties": {
        "projectId": { "type": "number" },
        "turbowarp": { "type": "boolean", "default": false }
      },
      "required": ["projectId"]
    },
    "linkShowcase": {
      "properties": {
        "href": { "type": "string", "default": "https://google.com" }
      },
      "required": ["href"]
    },
    "groupedShowcase": {
      "properties": {
        "children": {
          "type": "array",
          "minItems": 2,
          "items": {
            "allOf": [{ "$ref": "#/definitions/baseProperties" }, { "$ref": "#/definitions/otherProperties" }]
          }
        }
      },
      "required": ["children"]
    },

    "flags": {
      "type": "array",
      "items": {
        "enum": ["external", "keyboard_required", "mouse_required"]
      }
    },

    "tags": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "enum": ["math_museum"]
          },
          {
            "pattern": "festival_\\d+"
          }
        ]
      }
    }
  }
}
